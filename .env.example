# 复制为 .env，填好后再运行；.env 不要提交到仓库。
# GitHub Actions 上这几项配到 Settings → Secrets and variables → Actions。

# DeepSeek API key（https://platform.deepseek.com/api_keys），必填
DEEPSEEK_API_KEY=

# 发件邮箱（QQ 邮箱示例：you@qq.com）
SMTP_USER=

# QQ/163 等邮箱要填「授权码」（16 位），不是登录密码
SMTP_PASS=

# 收件人，多个用英文分号隔开：a@x.com;b@x.com
MAIL_TO=

# Bark 的完整地址，形如 https://api.day.app/你的key
BARK_URL=
